{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Card to Sheba API",
    "description": "Collection for testing Card-to-Sheba conversion service with ZarinHub integration.\n\n**Base URL:** `{{base_url}}`\n\n**Endpoints:**\n- `POST /api/v1/convert` - Convert card number to Sheba\n- `GET /healthz` - Health check\n\n**Error Codes:**\n- `INVALID_CARD_NUMBER` (400)\n- `EMPTY_CARD_NUMBER` (400)\n- `INVALID_CARD_FORMAT` (400)\n- `INVALID_JSON` (400)\n- `UNAUTHORIZED` (401)\n- `ZARINHUB_REJECTED` (422)\n- `ZARINHUB_TIMEOUT` (504)\n- `ZARINHUB_UNAVAILABLE` (503)\n- `INTERNAL_ERROR` (500)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has status field\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('status');",
                  "    pm.expect(jsonData.status).to.eql('ok');",
                  "});",
                  "",
                  "pm.test(\"Response time is less than 500ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(500);",
                  "});",
                  "",
                  "pm.test(\"Content-Type is JSON\", function () {",
                  "    pm.response.to.have.header('Content-Type');",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/healthz",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "healthz"
              ]
            },
            "description": "Check if the service is running and healthy."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Convert",
      "item": [
        {
          "name": "Convert - Success (Valid Card)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has sheba field\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('sheba');",
                  "    pm.expect(jsonData.sheba).to.be.a('string');",
                  "    pm.expect(jsonData.sheba).to.match(/^IR[0-9]{24}$/);",
                  "});",
                  "",
                  "pm.test(\"Response has request_id\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('request_id');",
                  "    pm.expect(jsonData.request_id).to.be.a('string');",
                  "    pm.expect(jsonData.request_id).to.not.be.empty;",
                  "});",
                  "",
                  "pm.test(\"Response time is less than 15s\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(15000);",
                  "});",
                  "",
                  "// ذخیره request_id برای استفاده در تست‌های بعدی",
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('last_request_id', jsonData.request_id);",
                  "    pm.collectionVariables.set('last_sheba', jsonData.sheba);",
                  "    console.log('Saved request_id:', jsonData.request_id);",
                  "    console.log('Saved sheba:', jsonData.sheba);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
